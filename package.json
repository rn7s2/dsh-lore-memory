{
  "name": "dsh-lore-memory",
  "version": "0.2.0",
  "description": "Per-workspace lore (the user's rules, shown every turn) and memory (the agent's own notes, loaded once per agent) for DeepSeek Harness, searchable in Chinese and English.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "native/**/*",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && git diff --exit-code lib/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rn7s2/dsh-lore-memory.git"
  },
  "homepage": "https://github.com/rn7s2/dsh-lore-memory#readme",
  "bugs": {
    "url": "https://github.com/rn7s2/dsh-lore-memory/issues"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
